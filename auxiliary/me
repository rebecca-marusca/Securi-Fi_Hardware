def detect_serial_ports():
    try:
        import serial.tools.list_ports
    except ImportError:
        print(f"{Fore.RED}pyserial is not installed.{Style.RESET_ALL}")
        print("Install it with: pip install pyserial")
        sys.exit(1)

    ports = []

    for port in serial.tools.list_ports.comports():
        desc_lower = port.description.lower()

        if any(
            k in desc_lower
            for k in ['usb', 'serial', 'uart', 'cp210', 'ch340', 'ftdi']
        ):
            ports.append(port.device)

    return ports


def get_serial_port(port_arg):
    if port_arg:
        return port_arg

    print(f"{Fore.YELLOW}Looking for a serial port...{Style.RESET_ALL}")

    ports = detect_serial_ports()

    if len(ports) == 0:
        print(f"{Fore.RED}No serial ports found.{Style.RESET_ALL}")
        print("Connect the ESP32 and try again.")
        sys.exit(1)

    elif len(ports) == 1:
        print(f"{Fore.GREEN}Using port {ports[0]}.{Style.RESET_ALL}\n")
        return ports[0]

    else:
        print(f"{Fore.YELLOW}Multiple serial ports found:{Style.RESET_ALL}")

        for i, port in enumerate(ports, 1):
            print(f"  {i}. {port}")

        print()

        try:
            choice = int(
                input(
                    f"{Fore.CYAN}"
                    f"Select port (1-{len(ports)}): "
                    f"{Style.RESET_ALL}"
                )
            )

            if 1 <= choice <= len(ports):
                selected = ports[choice - 1]
                print(f"{Fore.GREEN}Using port {selected}.{Style.RESET_ALL}\n")
                return selected

            print(f"{Fore.RED}Invalid port selection.{Style.RESET_ALL}")
            sys.exit(1)

        except (ValueError, KeyboardInterrupt):
            print(f"\n{Fore.RED}Cancelled.{Style.RESET_ALL}")
            sys.exit(1)


def detect_chip_type(port):
    try:
        import esptool
    except ImportError:
        return None

    esp = None

    try:
        print(f"{Fore.YELLOW}Detecting chip...{Style.RESET_ALL}")

        esp = esptool.get_default_connected_device(
            serial_list=[port],
            port=port,
            connect_attempts=3,
            initial_baud=115200
        )

        chip_name = esp.CHIP_NAME

        if 'ESP32-S3' in chip_name:
            print(f"{Fore.GREEN}Detected ESP32-S3.{Style.RESET_ALL}\n")
            return 's3'

        elif 'ESP32-C6' in chip_name:
            print(f"{Fore.GREEN}Detected ESP32-C6.{Style.RESET_ALL}\n")
            return 'c6'

        elif 'ESP32-C5' in chip_name:
            print(f"{Fore.GREEN}Detected ESP32-C5.{Style.RESET_ALL}\n")
            return 'c5'

        elif 'ESP32-C3' in chip_name:
            print(f"{Fore.GREEN}Detected ESP32-C3.{Style.RESET_ALL}\n")
            return 'c3'

        elif chip_name == 'ESP32':
            print(f"{Fore.GREEN}Detected ESP32.{Style.RESET_ALL}\n")
            return 'esp32'

        else:
            print(
                f"{Fore.YELLOW}"
                f"Unknown chip: {chip_name}"
                f"{Style.RESET_ALL}\n"
            )
            return None

    except Exception as e:
        print(
            f"{Fore.YELLOW}"
            f"Couldn't detect chip: {e}"
            f"{Style.RESET_ALL}"
        )
        return None

    finally:
        if esp and hasattr(esp, '_port') and esp._port:
            try:
                esp._port.close()
            except Exception:
                pass

        time.sleep(1)


def prompt_chip_type():
    print(f"\n{Fore.CYAN}Couldn't detect the chip.{Style.RESET_ALL}")
    print("Select the chip type:")
    print("  1. ESP32")
    print("  2. ESP32-C3")
    print("  3. ESP32-S3")
    print("  4. ESP32-C5")
    print("  5. ESP32-C6")
    print()

    try:
        choice = (
            input(
                f"{Fore.CYAN}"
                f"Chip [5]: "
                f"{Style.RESET_ALL}"
            ).strip()
            or "5"
        )

        mapping = {
            '1': 'esp32',
            '2': 'c3',
            '3': 's3',
            '4': 'c5',
            '5': 'c6'
        }

        chip = mapping.get(choice)

        if chip:
            print(f"{Fore.GREEN}Using {chip.upper()}.{Style.RESET_ALL}\n")
            return chip

        print(f"{Fore.RED}Invalid chip selection.{Style.RESET_ALL}")
        return None

    except (KeyboardInterrupt, EOFError):
        print(f"\n{Fore.RED}Cancelled.{Style.RESET_ALL}")
        return None


