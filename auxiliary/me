def _check_mpremote():
    try:
        subprocess.run(
            ['mpremote', '--version'],
            capture_output=True,
            check=True
        )

    except (subprocess.CalledProcessError, FileNotFoundError):
        print(f"{Fore.RED}mpremote is not installed.{Style.RESET_ALL}")
        print("Install it with: pip install mpremote")
        sys.exit(1)


def _flash_for_deploy(port):
    """Flash the project's ESP32-C6 CSI firmware before deploying code."""

    print()
    print(f"{Fore.MAGENTA}== Preparing board =={Style.RESET_ALL}")
    print(f"port:   {port}")
    print(f"chip:   ESP32-C6")
    print(f"action: erase + flash")
    print()

    flash_args = argparse.Namespace(
        chip='c6',
        port=port,
        erase=True,
        firmware=None,
    )

    flash_firmware(flash_args)

    print(
        f"{Fore.YELLOW}"
        f"Waiting for the board to reboot..."
        f"{Style.RESET_ALL}"
    )

    time.sleep(3)


def deploy_code(args):
    _check_mpremote()

    port = get_serial_port(args.port)

    # Normal deploy:
    #   1. erase flash
    #   2. flash CSI firmware
    #   3. wait for reboot
    #   4. upload SecuriFi files
    if not args.skip_flash:
        _flash_for_deploy(port)
        _check_mpremote()

    port = get_serial_port(args.port)

    node_info = NODE_DIRS[args.node]

    shared_dir = node_info["root"] / "shared"
    code_dir = node_info["root"] / node_info["code_subdir"]

    if not shared_dir.exists():
        print(
            f"{Fore.RED}"
            f"Shared directory not found: {shared_dir}"
            f"{Style.RESET_ALL}"
        )
        sys.exit(1)

    if not code_dir.exists():
        print(
            f"{Fore.RED}"
            f"Node directory not found: {code_dir}"
            f"{Style.RESET_ALL}"
        )
        sys.exit(1)

    print()
    print(
        f"{Fore.MAGENTA}"
        f"== Deploying {args.node} node =="
        f"{Style.RESET_ALL}"
    )
    print(f"port: {port}")
    print()

    # Make sure the board is actually running MicroPython.
    print(
        f"{Fore.YELLOW}"
        f"Checking MicroPython..."
        f"{Style.RESET_ALL}"
    )

    health = subprocess.run(
        [
            'mpremote',
            'connect',
            port,
            'exec',
            'print("MP_OK")'
        ],
        capture_output=True,
        text=True
    )

    if health.returncode != 0 or 'MP_OK' not in (health.stdout or ''):
        print(
            f"{Fore.RED}"
            f"Board isn't responding with a MicroPython REPL."
            f"{Style.RESET_ALL}"
        )
        print(
            f"{Fore.YELLOW}"
            f"Try: ./me.py flash --erase"
            f"{Style.RESET_ALL}"
        )
        sys.exit(1)

    print(
        f"{Fore.GREEN}"
        f"MicroPython is responding."
        f"{Style.RESET_ALL}"
    )

    # Create /shared and make it a Python package.
    print(
        f"{Fore.YELLOW}"
        f"Preparing /shared..."
        f"{Style.RESET_ALL}"
    )

    subprocess.run(
        [
            'mpremote',
            'connect',
            port,
            'mkdir',
            ':shared'
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False
    )

    subprocess.run(
        [
            'mpremote',
            'connect',
            port,
            'exec',
            "open('shared/__init__.py','w').close()"
        ],
        check=True,
        capture_output=True
    )

    # Upload shared/*.py
    print(
        f"{Fore.YELLOW}"
        f"Uploading shared files..."
        f"{Style.RESET_ALL}"
    )

    shared_files = sorted(shared_dir.glob("*.py"))

    if not shared_files:
        print(
            f"{Fore.RED}"
            f"No Python files found in {shared_dir}"
            f"{Style.RESET_ALL}"
        )
        sys.exit(1)

    for f in shared_files:
        print(f"  {f.name}")

        subprocess.run(
            [
                'mpremote',
                'connect',
                port,
                'cp',
                str(f),
                f':shared/{f.name}'
            ],
            check=True,
            capture_output=True
        )

    # Upload node-specific files.
    print(
        f"{Fore.YELLOW}"
        f"Uploading {args.node} files..."
        f"{Style.RESET_ALL}"
    )

    root_files = [
        "config.py",
        "main.py",
        node_info["node_module"]
    ]

    for name in root_files:
        src = code_dir / name

        if not src.exists():
            print(
                f"{Fore.RED}"
                f"Missing required file: {src}"
                f"{Style.RESET_ALL}"
            )
            sys.exit(1)

        print(f"  {name}")

        subprocess.run(
            [
                'mpremote',
                'connect',
                port,
                'cp',
                str(src),
                f':{name}'
            ],
            check=True,
            capture_output=True
        )

    # Generate node_id.txt locally and copy it to the ESP.
    #
    # Master:
    #   python me.py deploy --node master
    #   -> node_id.txt contains "master"
    #
    # Slave:
    #   python me.py deploy --node slave --slave_id 1
    #   -> node_id.txt contains "slave_1"
    #
    # There is intentionally no node_id.txt required in the repo anymore.

    if args.node == "master":
        node_id_value = "master"

    else:
        if not args.slave_id:
            print(
                f"{Fore.RED}"
                f"Slave deployment requires --slave_id."
                f"{Style.RESET_ALL}"
            )
            sys.exit(1)

        node_id_value = f"slave_{args.slave_id}"

    with tempfile.NamedTemporaryFile(
        "w",
        suffix=".txt",
        delete=False
    ) as tmp:
        tmp.write(node_id_value)
        tmp_path = tmp.name

    print(f"  node_id.txt -> {node_id_value}")

    try:
        subprocess.run(
            [
                'mpremote',
                'connect',
                port,
                'cp',
                tmp_path,
                ':node_id.txt'
            ],
            check=True,
            capture_output=True
        )

    finally:
        os.unlink(tmp_path)

    print()
    print(
        f"{Fore.GREEN}"
        f"Deployment complete."
        f"{Style.RESET_ALL}"
    )


