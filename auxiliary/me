def verify_installation(args):
    port = get_serial_port(args.port)

    print()
    print(
        f"{Fore.MAGENTA}"
        f"== Checking installation =="
        f"{Style.RESET_ALL}"
    )
    print(f"port: {port}")
    print()

    all_ok = True

    # CSI firmware
    print(
        f"{Fore.YELLOW}"
        f"Checking CSI support..."
        f"{Style.RESET_ALL}"
    )

    try:
        result = subprocess.run(
            [
                'mpremote',
                'connect',
                port,
                'exec',
                (
                    "import network; "
                    "wlan = network.WLAN(network.STA_IF); "
                    "m = [x for x in dir(wlan) if 'csi' in x.lower()]; "
                    "import esp; "
                    "m2 = [x for x in dir(esp) if 'csi' in x.lower()]; "
                    "print(','.join(m + m2) if (m or m2) else 'NONE')"
                )
            ],
            capture_output=True,
            text=True,
            check=True
        )

        found = result.stdout.strip()

        if found and found != 'NONE':
            print(
                f"{Fore.GREEN}"
                f"CSI support: {found}"
                f"{Style.RESET_ALL}"
            )
        else:
            print(
                f"{Fore.RED}"
                f"CSI support not found."
                f"{Style.RESET_ALL}"
            )

            print(
                f"{Fore.YELLOW}"
                f"Try: ./me.py flash --erase"
                f"{Style.RESET_ALL}"
            )

            all_ok = False

    except subprocess.CalledProcessError as e:
        error = (e.stderr or "").strip()

        print(
            f"{Fore.RED}"
            f"CSI check failed"
            f"{Style.RESET_ALL}"
        )

        if error:
            print(f"  {error}")

        all_ok = False

    print()

    # Root files
    print(
        f"{Fore.YELLOW}"
        f"Checking root files..."
        f"{Style.RESET_ALL}"
    )

    try:
        result = subprocess.run(
            [
                'mpremote',
                'connect',
                port,
                'exec',
                'import os; print(os.listdir("/"))'
            ],
            capture_output=True,
            text=True,
            check=True
        )

        listing = result.stdout.strip()

        print(f"  {listing}")

        for required in (
            "main.py",
            "config.py",
            "node_id.txt",
            "shared"
        ):
            if required not in listing:
                print(
                    f"{Fore.RED}"
                    f"  Missing: {required}"
                    f"{Style.RESET_ALL}"
                )
                all_ok = False

    except subprocess.CalledProcessError:
        print(
            f"{Fore.RED}"
            f"Couldn't list the device root."
            f"{Style.RESET_ALL}"
        )
        all_ok = False

    print()

    # Shared files
    print(
        f"{Fore.YELLOW}"
        f"Checking /shared..."
        f"{Style.RESET_ALL}"
    )

    try:
        result = subprocess.run(
            [
                'mpremote',
                'connect',
                port,
                'exec',
                'import os; print(os.listdir("/shared"))'
            ],
            capture_output=True,
            text=True,
            check=True
        )

        listing = result.stdout.strip()

        print(f"  {listing}")

        for required in (
            "__init__.py",
            "securifi_node.py",
            "csi_capture.py",
            "mvs_detector.py",
            "traffic_generator.py",
            "mq2.py"
        ):
            if required not in listing:
                print(
                    f"{Fore.RED}"
                    f"  Missing: shared/{required}"
                    f"{Style.RESET_ALL}"
                )
                all_ok = False

    except subprocess.CalledProcessError:
        print(
            f"{Fore.RED}"
            f"Couldn't list /shared."
            f"{Style.RESET_ALL}"
        )
        all_ok = False

    print()

    # Node ID
    print(
        f"{Fore.YELLOW}"
        f"Checking node_id.txt..."
        f"{Style.RESET_ALL}"
    )

    try:
        result = subprocess.run(
            [
                'mpremote',
                'connect',
                port,
                'exec',
                "print(open('node_id.txt').read().strip())"
            ],
            capture_output=True,
            text=True,
            check=True
        )

        print(
            f"{Fore.GREEN}"
            f"  node_id: {result.stdout.strip()}"
            f"{Style.RESET_ALL}"
        )

    except subprocess.CalledProcessError:
        print(
            f"{Fore.RED}"
            f"Couldn't read node_id.txt."
            f"{Style.RESET_ALL}"
        )
        all_ok = False

    print()

    if all_ok:
        print(
            f"{Fore.GREEN}"
            f"Installation looks good."
            f"{Style.RESET_ALL}"
        )
    else:
        print(
            f"{Fore.RED}"
            f"Some checks failed."
            f"{Style.RESET_ALL}"
        )
        sys.exit(1)


# ============================================================================
# main
# ============================================================================

def main():
    parser = argparse.ArgumentParser(
        description="SecuriFi firmware CLI — flash / deploy / run / verify",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Flash the CSI-enabled MicroPython firmware
  ./me.py flash --erase

  # Complete master deployment
  ./me.py deploy --node master

  # Complete slave deployment
  ./me.py deploy --node slave --slave_id 2

  # Upload Python code without reflashing
  ./me.py deploy --node master --skip-flash

  # Run the deployed firmware
  ./me.py run

  # Check what's on the board
  ./me.py verify
"""
    )

    sub = parser.add_subparsers(
        dest='command',
        help='Available commands'
    )

    flash_p = sub.add_parser(
        'flash',
        help='Flash the CSI-enabled MicroPython firmware'
    )

    flash_p.add_argument(
        '--chip',
        choices=['esp32', 'c3', 's3', 'c5', 'c6'],
        help='Chip type (default: auto-detect, project default is c6)'
    )

    flash_p.add_argument(
        '--port',
        help='Serial port (auto-detected if omitted)'
    )

    flash_p.add_argument(
        '--erase',
        action='store_true',
        help='Erase flash before flashing'
    )

    flash_p.add_argument(
        '--firmware',
        help='Path to a custom firmware .bin'
    )

    deploy_p = sub.add_parser(
        'deploy',
        help='Deploy master or slave code to the board'
    )

    deploy_p.add_argument(
        '--node',
        choices=['master', 'slave'],
        required=True,
        help='Which node type to deploy'
    )

    deploy_p.add_argument(
        '--port',
        help='Serial port (auto-detected if omitted)'
    )

    deploy_p.add_argument(
        '--slave_id',
        choices=['1', '2', '3'],
        help='Slave ID: 1, 2 or 3'
    )

    deploy_p.add_argument(
        '--skip-flash',
        action='store_true',
        help='Skip erase + firmware flash'
    )

    run_p = sub.add_parser(
        'run',
        help='Run main.py on the board and stream logs'
    )

    run_p.add_argument(
        '--port',
        help='Serial port (auto-detected if omitted)'
    )

    verify_p = sub.add_parser(
        'verify',
        help='Verify firmware and deployed files'
    )

    verify_p.add_argument(
        '--port',
        help='Serial port (auto-detected if omitted)'
    )

    args = parser.parse_args()

    if args.command == 'flash':
        flash_firmware(args)

    elif args.command == 'deploy':
        deploy_code(args)

    elif args.command == 'run':
        run_application(args)

    elif args.command == 'verify':
        verify_installation(args)

    else:
        parser.print_help()


if __name__ == "__main__":
    main()
