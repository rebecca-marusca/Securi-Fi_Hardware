def _check_mpremote():
    try:
        subprocess.run(['mpremote', '--version'], capture_output=True, check=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        print(f"{Fore.RED}❌ mpremote not found. Install it with:{Style.RESET_ALL}")
        print("   pip install mpremote")
        sys.exit(1)


def deploy_code(args):
    _check_mpremote()
    port = get_serial_port(args.port)

    node_info = NODE_DIRS[args.node]
    shared_dir = node_info["root"] / "shared"
    code_dir = node_info["root"] / node_info["code_subdir"]

    if not shared_dir.exists():
        print(f"{Fore.RED}❌ Shared dir not found: {shared_dir}{Style.RESET_ALL}")
        sys.exit(1)
    if not code_dir.exists():
        print(f"{Fore.RED}❌ Code dir not found: {code_dir}{Style.RESET_ALL}")
        sys.exit(1)

    print(f"\n{Fore.MAGENTA}== SecuriFi — Deploying '{args.node}' node =={Style.RESET_ALL}")
    print(f"{Fore.CYAN}Port: {port}{Style.RESET_ALL}\n")

    # Sanity check the board is alive before we start copying files.
    health = subprocess.run(
        ['mpremote', 'connect', port, 'exec', 'print("MP_OK")'],
        capture_output=True, text=True
    )
    if health.returncode != 0 or 'MP_OK' not in (health.stdout or ''):
        print(f"{Fore.RED}❌ Device is not responding with a valid MicroPython REPL{Style.RESET_ALL}")
        print(f"{Fore.YELLOW}   Try reflashing: ./me.py flash --erase{Style.RESET_ALL}")
        sys.exit(1)

    # Create /shared on the device and make it an importable package.
    print(f"{Fore.YELLOW}📁 Preparing /shared package...{Style.RESET_ALL}")
    subprocess.run(['mpremote', 'connect', port, 'mkdir', ':shared'],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(
        ['mpremote', 'connect', port, 'exec', "open('shared/__init__.py','w').close()"],
        check=True, capture_output=True
    )

    # Upload shared/*.py
    print(f"{Fore.YELLOW}📤 Uploading shared/ files...{Style.RESET_ALL}")
    shared_files = sorted(shared_dir.glob("*.py"))
    if not shared_files:
        print(f"{Fore.RED}❌ No .py files found in {shared_dir}{Style.RESET_ALL}")
        sys.exit(1)
    for f in shared_files:
        print(f"  {f} → :shared/{f.name}")
        subprocess.run(['mpremote', 'connect', port, 'cp', str(f), f':shared/{f.name}'],
                        check=True, capture_output=True)

    # Upload node-specific files to device root.
    print(f"{Fore.YELLOW}📤 Uploading node files...{Style.RESET_ALL}")
    root_files = ["config.py", "main.py", node_info["node_module"]]

    for name in root_files:
        src = code_dir / name
        if not src.exists():
            print(f"{Fore.RED}  ❌ Missing required file: {src}{Style.RESET_ALL}")
            sys.exit(1)
        print(f"  {src} → :{name}")
        subprocess.run(['mpremote', 'connect', port, 'cp', str(src), f':{name}'],
                        check=True, capture_output=True)

    # node_id.txt — for slaves, optionally override with --slave_id so the
    # same tracked file can be reused across 3 physical boards.
    node_id_src = code_dir / "node_id.txt"
    if args.node == "slave" and args.slave_id:
        node_id_value = f"slave_{args.slave_id}"
        with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False) as tmp:
            tmp.write(node_id_value)
            tmp_path = tmp.name
        print(f"  (generated) → :node_id.txt  [{node_id_value}]")
        subprocess.run(['mpremote', 'connect', port, 'cp', tmp_path, ':node_id.txt'],
                        check=True, capture_output=True)
        os.unlink(tmp_path)
    else:
        if not node_id_src.exists():
            print(f"{Fore.RED}  ❌ Missing required file: {node_id_src}{Style.RESET_ALL}")
            sys.exit(1)
        print(f"  {node_id_src} → :node_id.txt")
        subprocess.run(['mpremote', 'connect', port, 'cp', str(node_id_src), ':node_id.txt'],
                        check=True, capture_output=True)

    print(f"\n{Fore.GREEN}✅ Deployment complete!{Style.RESET_ALL}")
    print(f"{Fore.CYAN}Run it with:{Style.RESET_ALL}  ./me.py run --port {port}\n")


