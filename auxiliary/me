def run_application(args):
    _check_mpremote()
    port = get_serial_port(args.port)

    print(f"\n{Fore.MAGENTA}== SecuriFi — Running main.py =={Style.RESET_ALL}\n")

    process = None
    try:
        process = subprocess.Popen(['mpremote', 'connect', port, 'run', 'main.py'])
        process.wait()
    except KeyboardInterrupt:
        print(f"\n{Fore.YELLOW}Stopped — resetting device...{Style.RESET_ALL}")
        if process:
            process.terminate()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                process.kill()
        time.sleep(0.5)
        try:
            subprocess.run(
                ['mpremote', 'connect', port, 'exec', 'import machine; machine.reset()'],
                timeout=5, capture_output=True
            )
        except Exception:
            pass
        print(f"{Fore.GREEN}Reset sent.{Style.RESET_ALL}")
    except Exception as e:
        print(f"\n{Fore.RED}❌ Unexpected error: {e}{Style.RESET_ALL}")
        sys.exit(1)


