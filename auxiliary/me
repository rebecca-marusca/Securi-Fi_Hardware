def main():
    parser = argparse.ArgumentParser(
        description="SecuriFi firmware CLI — flash / deploy / run / verify",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Flash the CSI-enabled MicroPython firmware (auto-detect port & chip, default C6)
  ./me.py flash --erase

  # Deploy the master node
  ./me.py deploy --node master

  # Deploy slave board #2 (reuses slave_node/slave/node_id.txt as a template,
  # overriding its content to "slave_2" for this specific board)
  ./me.py deploy --node slave --slave_id 2

  # Run the deployed firmware and see live logs
  ./me.py run

  # Sanity-check what's on the board
  ./me.py verify
"""
    )
    sub = parser.add_subparsers(dest='command', help='Available commands')

    flash_p = sub.add_parser('flash', help='Flash the CSI-enabled MicroPython firmware')
    flash_p.add_argument('--chip', choices=['esp32', 'c3', 's3', 'c5', 'c6'],
                          help='Chip type (default: auto-detect, project default is c6)')
    flash_p.add_argument('--port', help='Serial port (auto-detected if omitted)')
    flash_p.add_argument('--erase', action='store_true', help='Erase flash before flashing (recommended)')
    flash_p.add_argument('--firmware', help='Path to a custom firmware .bin (optional)')

    deploy_p = sub.add_parser('deploy', help='Deploy master or slave code to the board')
    deploy_p.add_argument('--node', choices=['master', 'slave'], required=True,
                           help='Which node type to deploy')
    deploy_p.add_argument('--port', help='Serial port (auto-detected if omitted)')
    deploy_p.add_argument('--slave_id', choices=['1', '2', '3'],
                           help='Override node_id.txt to slave_<id> (slave only, per physical board)')

    run_p = sub.add_parser('run', help='Run main.py on the board and stream logs')
    run_p.add_argument('--port', help='Serial port (auto-detected if omitted)')

    verify_p = sub.add_parser('verify', help='Verify firmware + deployed files on the board')
    verify_p.add_argument('--port', help='Serial port (auto-detected if omitted)')

    args = parser.parse_args()

    if args.command == 'flash':
        flash_firmware(args)
    elif args.command == 'deploy':
        deploy_code(args)
    elif args.command == 'run':
        run_application(args)
    elif args.command == 'verify':
        verify_installation(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()