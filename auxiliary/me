def download_firmware(chip: str, firmware_dir: Path) -> Path:
    import urllib.request
    import urllib.error
    import hashlib

    chip_suffix_map = {
        'esp32': '',
        'c3': 'C3',
        's3': 'S3',
        'c5': 'C5',
        'c6': 'C6'
    }

    chip_suffix = chip_suffix_map.get(chip, chip.upper())

    firmware_name = (
        f'{FIRMWARE_NAME_PREFIX}{chip_suffix}.bin'
        if chip_suffix
        else 'ESP32_CSI.bin'
    )

    firmware_path = firmware_dir / firmware_name
    expected_hash = FIRMWARE_HASHES.get(firmware_name)

    def sha256_of(path: Path) -> str:
        h = hashlib.sha256()

        with open(path, 'rb') as f:
            for chunk in iter(lambda: f.read(8192), b''):
                h.update(chunk)

        return h.hexdigest()

    if firmware_path.exists():

        if expected_hash:
            if sha256_of(firmware_path) == expected_hash:
                print(
                    f"{Fore.GREEN}"
                    f"Using cached firmware: {firmware_name}"
                    f"{Style.RESET_ALL}"
                )
                return firmware_path

            print(
                f"{Fore.YELLOW}"
                f"Cached firmware hash doesn't match. Downloading again."
                f"{Style.RESET_ALL}"
            )

            firmware_path.unlink()

        else:
            print(
                f"{Fore.GREEN}"
                f"Using cached firmware: {firmware_name}"
                f"{Style.RESET_ALL}"
            )
            return firmware_path

    firmware_dir.mkdir(parents=True, exist_ok=True)

    url = f"{FIRMWARE_RELEASE_URL}/{firmware_name}"

    print(
        f"{Fore.YELLOW}"
        f"Downloading {firmware_name}..."
        f"{Style.RESET_ALL}"
    )

    try:
        with urllib.request.urlopen(url, timeout=60) as response:

            total = int(response.headers.get('content-length', 0))
            downloaded = 0

            with open(firmware_path, 'wb') as f:

                while True:
                    chunk = response.read(8192)

                    if not chunk:
                        break

                    f.write(chunk)
                    downloaded += len(chunk)

                    if total:
                        pct = (downloaded * 100) // total
                        print(
                            f"\r   {pct}%",
                            end='',
                            flush=True
                        )

            print()

        if expected_hash and sha256_of(firmware_path) != expected_hash:
            print(
                f"{Fore.RED}"
                f"Downloaded firmware hash doesn't match."
                f"{Style.RESET_ALL}"
            )

            firmware_path.unlink()
            sys.exit(1)

        print(
            f"{Fore.GREEN}"
            f"Firmware ready: {firmware_name}"
            f"{Style.RESET_ALL}"
        )

        return firmware_path

    except urllib.error.URLError as e:
        print(
            f"{Fore.RED}"
            f"Firmware download failed: {e}"
            f"{Style.RESET_ALL}"
        )
        sys.exit(1)


def flash_firmware(args):
    try:
        import esptool
    except ImportError:
        print(f"{Fore.RED}esptool is not installed.{Style.RESET_ALL}")
        print("Install it with: pip install esptool")
        sys.exit(1)

    port = get_serial_port(args.port)

    chip = args.chip

    if not chip:
        chip = detect_chip_type(port) or prompt_chip_type()

        if not chip:
            sys.exit(1)

    firmware_dir = REPO_ROOT / 'firmware'

    if args.firmware:
        firmware_path = Path(args.firmware)

        if not firmware_path.exists():
            print(
                f"{Fore.RED}"
                f"Firmware not found: {firmware_path}"
                f"{Style.RESET_ALL}"
            )
            sys.exit(1)

    else:
        firmware_path = download_firmware(chip, firmware_dir)

    print()
    print(f"{Fore.MAGENTA}== Flashing CSI firmware =={Style.RESET_ALL}")
    print(f"chip:     {chip.upper()}")
    print(f"port:     {port}")
    print(f"firmware: {firmware_path.name}")
    print()

    chip_name_map = {
        'esp32': 'esp32',
        'c3': 'esp32c3',
        's3': 'esp32s3',
        'c5': 'esp32c5',
        'c6': 'esp32c6'
    }

    chip_name = chip_name_map.get(chip, 'esp32c6')

    base_args = [
        '--chip',
        chip_name,
        '--port',
        port,
        '--baud',
        '460800'
    ]

    try:

        if args.erase:
            print(f"{Fore.YELLOW}Erasing flash...{Style.RESET_ALL}")

            esptool.main(
                base_args + ['erase-flash']
            )

            print(f"{Fore.GREEN}Flash erased.{Style.RESET_ALL}\n")

            time.sleep(2)

        print(f"{Fore.YELLOW}Writing firmware...{Style.RESET_ALL}")

        flash_offset_map = {
            'esp32': '0x1000',
            'c3': '0x0',
            's3': '0x0',
            'c5': '0x2000',
            'c6': '0x0'
        }

        flash_offset = flash_offset_map.get(chip, '0x0')

        flash_args = base_args + [
            '--before',
            'default-reset',
            '--after',
            'hard-reset',
            'write-flash',
            '--flash-mode',
            'dio',
            '--flash-freq',
            '40m',
            '--flash-size',
            'detect',
            flash_offset,
            str(firmware_path)
        ]

        max_retries = 3

        for attempt in range(max_retries):

            try:

                if attempt > 0:
                    print(
                        f"{Fore.YELLOW}"
                        f"Retrying ({attempt + 1}/{max_retries})..."
                        f"{Style.RESET_ALL}"
                    )

                    time.sleep(2)

                esptool.main(flash_args)

                print(
                    f"\n{Fore.GREEN}"
                    f"Flash complete."
                    f"{Style.RESET_ALL}\n"
                )

                return

            except Exception as e:

                if attempt < max_retries - 1:
                    print(
                        f"{Fore.YELLOW}"
                        f"Flash attempt {attempt + 1} failed: {e}"
                        f"{Style.RESET_ALL}"
                    )
                    continue

                raise

    except Exception as e:

        print(
            f"\n{Fore.RED}"
            f"Flash failed: {e}"
            f"{Style.RESET_ALL}"
        )

        print(f"\n{Fore.YELLOW}Things to check:{Style.RESET_ALL}")
        print("  - Board is connected")
        print("  - No other program is using the serial port")
        print("  - USB cable supports data")
        print("  - Try holding BOOT while flashing")
        print(
            f"  - Try again with: "
            f"{Fore.GREEN}./me.py flash --erase{Style.RESET_ALL}"
        )

        sys.exit(1)


