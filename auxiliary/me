def verify_installation(args):
    port = get_serial_port(args.port)

    print(f"\n{Fore.MAGENTA}== SecuriFi — Verifying installation =={Style.RESET_ALL}\n")
    all_ok = True

    print(f"{Fore.YELLOW}🔍 Checking CSI firmware support...{Style.RESET_ALL}")
    try:
        result = subprocess.run([
            'mpremote', 'connect', port, 'exec',
            "import network; wlan = network.WLAN(network.STA_IF); "
            "m = [x for x in dir(wlan) if 'csi' in x.lower()]; "
            "import esp; m2 = [x for x in dir(esp) if 'csi' in x.lower()]; "
            "print(','.join(m + m2) if (m or m2) else 'NONE')"
        ], capture_output=True, text=True, check=True)
        found = result.stdout.strip()
        if found and found != 'NONE':
            print(f"{Fore.GREEN}✅ CSI support found: {found}{Style.RESET_ALL}")
        else:
            print(f"{Fore.RED}❌ CSI support not found in firmware{Style.RESET_ALL}")
            print(f"{Fore.YELLOW}   Hint: ./me.py flash --erase{Style.RESET_ALL}")
            all_ok = False
    except subprocess.CalledProcessError as e:
        print(f"{Fore.RED}❌ Failed to check CSI support: {e.stderr.strip()}{Style.RESET_ALL}")
        all_ok = False
    print()

    print(f"{Fore.YELLOW}🔍 Checking deployed files (root)...{Style.RESET_ALL}")
    try:
        result = subprocess.run([
            'mpremote', 'connect', port, 'exec', 'import os; print(os.listdir("/"))'
        ], capture_output=True, text=True, check=True)
        listing = result.stdout.strip()
        print(f"{Fore.GREEN}✅ Root files: {listing}{Style.RESET_ALL}")
        for required in ("main.py", "config.py", "node_id.txt", "shared"):
            if required not in listing:
                print(f"{Fore.RED}  ❌ Missing: {required}{Style.RESET_ALL}")
                all_ok = False
    except subprocess.CalledProcessError:
        print(f"{Fore.RED}❌ Could not list device files{Style.RESET_ALL}")
        all_ok = False
    print()

    print(f"{Fore.YELLOW}🔍 Checking /shared package...{Style.RESET_ALL}")
    try:
        result = subprocess.run([
            'mpremote', 'connect', port, 'exec', 'import os; print(os.listdir("/shared"))'
        ], capture_output=True, text=True, check=True)
        listing = result.stdout.strip()
        print(f"{Fore.GREEN}✅ /shared files: {listing}{Style.RESET_ALL}")
        for required in ("__init__.py", "securifi_node.py", "csi_capture.py",
                          "mvs_detector.py", "traffic_generator.py", "mq2.py"):
            if required not in listing:
                print(f"{Fore.RED}  ❌ Missing: shared/{required}{Style.RESET_ALL}")
                all_ok = False
    except subprocess.CalledProcessError:
        print(f"{Fore.RED}❌ Could not list /shared{Style.RESET_ALL}")
        all_ok = False
    print()

    print(f"{Fore.YELLOW}🔍 Reading node_id.txt...{Style.RESET_ALL}")
    try:
        result = subprocess.run([
            'mpremote', 'connect', port, 'exec',
            "print(open('node_id.txt').read().strip())"
        ], capture_output=True, text=True, check=True)
        print(f"{Fore.GREEN}✅ node_id: {result.stdout.strip()}{Style.RESET_ALL}")
    except subprocess.CalledProcessError:
        print(f"{Fore.RED}❌ Could not read node_id.txt{Style.RESET_ALL}")
        all_ok = False
    print()

    if all_ok:
        print(f"{Fore.GREEN}✅ Installation verified successfully!{Style.RESET_ALL}")
        print(f"{Fore.CYAN}Run it with:{Style.RESET_ALL} ./me.py run --port {port}\n")
    else:
        print(f"{Fore.RED}❌ Some checks failed — see above.{Style.RESET_ALL}\n")
        sys.exit(1)


